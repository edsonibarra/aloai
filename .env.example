# Postgres (e.g. Neon). DATABASE_URL is the pooled connection used by the app;
# DIRECT_URL is the direct connection used for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Long random string used to sign session cookies
SESSION_SECRET="change-me-to-a-long-random-string"
# Claude API key used by Alo (server-side only). Must be scoped to a workspace.
# ANTHROPIC_API_KEY="sk-ant-..."

# Stripe (billing stays off, and every unlocked level stays playable, until all three are set)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Public site URL used for Checkout redirects (defaults to the request origin)
# APP_URL="https://your-domain.com"
# Support address shown on the Terms page (defaults to "the address on your Stripe receipt")
# SUPPORT_EMAIL="support@your-domain.com"
